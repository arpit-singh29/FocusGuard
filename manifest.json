{
    "manifest_version":3,
    "name":"FocusGuard",
    "version":"1.0.0",
    "description":"A productivity-focused browser extension that blocks distracting websites and helps users stay focused.",
    "action":{
        "default_popup":"popup/popup.html"
    },

    "icons":{
        "16":"assets/icons/icon16.png",
        "32":"assets/icons/icon32.png",
        "48":"assets/icons/icon48.png",
        "128":"assets/icons/icon128.png"
    },

    "permissions":[
        "storage",
        "tabs",
        "alarms"
    ],

    "host_permissions":[
        "https://*/*",
        "http://*/*"
    ],

    "background":{
        "service_worker":"background/background.js"
    }

}

